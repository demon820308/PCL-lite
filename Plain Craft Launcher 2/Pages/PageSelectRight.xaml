<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    mc:Ignorable="d" x:Class="PageSelectRight"
    PanScroll="PanBack">
    <Grid>
        <Grid x:Name="PanAllBack">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <local:MyCard Grid.Row="0" x:Name="CardFolderBar" Margin="25,20,25,0" UseAnimation="False">
                <Grid Margin="16,11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="游戏文件夹" VerticalAlignment="Center" Margin="2,0,12,0" FontSize="13.5" Foreground="{DynamicResource ColorBrush3}" />
                    <local:MyComboBox Grid.Column="1" x:Name="ComboFolder" Height="30" VerticalContentAlignment="Center" ToolTip="切换当前管理的 .minecraft 游戏文件夹" />
                    <local:MyButton Grid.Column="2" x:Name="BtnFolderAdd" Height="30" Margin="8,0,0,0" Padding="11,0" Text="+ 添加文件夹" ToolTip="将一个已有的 Minecraft 文件夹添加到列表" />
                    <local:MyButton Grid.Column="3" x:Name="BtnFolderOpen" Height="30" Margin="8,0,0,0" Padding="11,0" Text="打开目录" ToolTip="在资源管理器中打开当前游戏文件夹" />
                    <local:MyButton Grid.Column="4" x:Name="BtnFolderRename" Height="30" Margin="8,0,0,0" Padding="11,0" Text="重命名" ToolTip="修改当前文件夹的显示名称" />
                </Grid>
            </local:MyCard>
            <local:MyScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
                <StackPanel Name="PanMain" Margin="25,15,25,10" Grid.IsSharedSizeScope="True" />
            </local:MyScrollViewer>
            <local:MyCard Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40" x:Name="PanEmpty" UseAnimation="False">
                <StackPanel Margin="20,17">
                    <TextBlock Name="LabEmptyTitle" Margin="0,0,0,9" HorizontalAlignment="Center" Text="无可用版本" FontSize="19" UseLayoutRounding="True" SnapsToDevicePixels="True" Foreground="{DynamicResource ColorBrush3}" />
                    <Rectangle HorizontalAlignment="Stretch" Height="2" Fill="{DynamicResource ColorBrush3}" />
                    <TextBlock Name="LabEmptyContent" Margin="10,15,10,5" Text="未找到任何版本的游戏，请先下载任意版本的游戏。&#xa;若有已存在的游戏，请点击上方“+ 添加文件夹”，选择 .minecraft 文件夹将其导入。" TextWrapping="Wrap" />
                    <local:MyButton Height="35" HorizontalAlignment="Center" x:Name="BtnEmptyDownload" MinWidth="140" Text="下载游戏" Margin="0,10,0,0" Padding="13,0" ColorType="Highlight" />
                </StackPanel>
            </local:MyCard>
        </Grid>
        <local:MyCard HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True" x:Name="PanLoad" Margin="40">
            <local:MyLoading Text="正在获取版本列表" Margin="20,20,20,17" x:Name="Load" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" AutoRun="False" />
        </local:MyCard>
    </Grid>
</local:MyPageRight>