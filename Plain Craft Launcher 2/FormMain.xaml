9-50.291-64.911-114.577-97.367-192.856-97.367-86.851 0-156.835 40.318-209.95 120.953l-47.995-28.02c-15.263-8.91-20.412-28.507-11.502-43.77a32 32 0 0 1 2.344-3.47zM107.691 419.47C205.24 278.491 337.805 208 505.379 208c178.77 0 317.694 80.224 416.772 240.672l-56.54 31.73c-13.686 7.68-30.922 4.303-40.697-7.975C735.581 360.213 629.07 303.009 505.38 300.815 373.997 298.485 261.637 362.88 168.3 494l-50.116-28.505c-15.362-8.738-20.732-28.275-11.994-43.637a32 32 0 0 1 1.5-2.387z"/> <local:MyRadioButton x:Name="BtnTitleSelect3" Text="设置" Tag="3" Margin="2,0" Padding="6,0" Foreground="#1D1D1F" LogoScale="0.95" Logo="M940.4 463.7L773.3 174.2c-17.3-30-49.2-48.4-83.8-48.4H340.2c-34.6 0-66.5 18.5-83.8 48.4L89.2 463.7c-17.3 30-17.3 66.9 0 96.8L256.4 850c17.3 30 49.2 48.4 83.8 48.4h349.2c34.6 0 66.5-18.5 83.8-48.4l167.2-289.5c17.3-29.9 17.3-66.8 0-96.8z m-94.6 96.8L725.9 768.1c-17.3 30-49.2 48.4-83.8 48.4H387.5c-34.6 0-66.5-18.5-83.8-48.4L183.9 560.5c-17.3-30-17.3-66.9 0-96.8l119.8-207.5c17.3-30 49.2-48.4 83.8-48.4h254.6c34.6 0 66.5 18.5 83.8 48.4l119.8 207.5c17.3 30 17.3 66.9 0.1 96.8z M522.3 321.2c-2.5-0.1-5-0.2-7.5-0.2-119.9 0-214 110.3-186.3 235 15.8 70.9 71.5 126.6 142.4 142.4 17.5 3.9 34.7 5.4 51.4 4.7 102.1-3.9 183.6-87.9 183.6-191 0.1-103-81.5-187-183.6-190.9z m68.6 269.1c-18.5 18-43 28.9-68.6 30.7l-6 0.3c-30.2 0.4-58.6-11.4-79.7-33-19.5-20.1-30.7-47-30.9-75-0.3-29.6 11.1-57.4 32-78.3 20.6-20.6 48-32 77.2-32 2.5 0 5 0.1 7.5 0.3 26.7 1.8 51.5 13.2 70.5 32.5 19.6 20 30.8 46.9 31.2 74.9 0.2 30.2-11.5 58.6-33.2 79.6z"/> <local:MyRadioButton x:Name="BtnTitleSelect4" Text="更多" Tag="4" Margin="2,0" Padding="6,0" Foreground="#1D1D1F" LogoScale="0.85" Logo="M364 0h-273C40 0 0 40 0 91v273C0 414 40 455 91 455h273C414 455 455 414 455 364V91C455 40 414 0 364 0zM341 341H113V113h227v227zM933 0h-273C609 0 568 40 568 91v273c0 50 40 91 91 91h273C983 455 1024 414 1024 364V91c0-50-40-91-90-91zM910 341h-227V113h227v227zM364 568h-273C40 568 0 609 0 659v273c0 50 40 91 91 91h273C414 1024 455 983 455 932v-273C455 609 414 568 364 568zM341 910H113v-227h227v227zM933 568h-273c-50 0-91 40-91 91v273c0 50 40 91 91 91h273c50 0 90-40 90-91v-273c0-50-40-90-90-90zM910 910h-227v-227h227v227z"/> </StackPanel> <Rectangle Width="1" Height="16" Fill="#D1D1D6" Margin="6,0" VerticalAlignment="Center" /> <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0"> <local:MyIconButton x:Name="BtnTitleMin" Width="24" Height="24" Margin="0,0,4,0" Theme="Black" Cursor="Hand" ToolTip="最小化" LogoScale="0.55" Logo="F1 M0,0 h12 v2 h-12 Z" /> <local:MyIconButton x:Name="BtnTitleClose" Width="24" Height="24" Theme="Red" Cursor="Hand" ToolTip="关闭" LogoScale="0.55" Logo="F1 M2,0 L0,2 8,10 0,18 2,20 10,12 18,20 20,18 12,10 20,2 18,0 10,8 2,0Z" /> </StackPanel> </StackPanel> </Border> <!-- 右上角圆形触发图标 --> <Border x:Name="BtnTopRightTrigger" Width="30" Height="30" CornerRadius="15" Background="#E5E5EA" Cursor="Hand" VerticalAlignment="Center" ToolTip="悬停展开菜单"> <Path x:Name="ShapeTopRightTrigger" Data="M192 512a64 64 0 1 0 128 0 64 64 0 1 0-128 0z m256 0a64 64 0 1 0 128 0 64 64 0 1 0-128 0z m256 0a64 64 0 1 0 128 0 64 64 0 1 0-128 0z" Fill="#1D1D1F" Stretch="Uniform" Width="14" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" /> </Border> </StackPanel> </Border> </Grid>

<!-- 分割线：极淡细线 (1px，仿 macOS 窗口分割) --> <Rectangle Grid.Row="0" VerticalAlignment="Bottom" Height="1" Fill="#0F000000" IsHitTestVisible="False"/>

<!-- 侧边栏过渡区域（纯白背景） --> <Grid x:Name="PanLeft" Grid.Row="1" HorizontalAlignment="Left" SnapsToDevicePixels="True"> <Grid.ColumnDefinitions> <ColumnDefinition Width="Auto"/> <ColumnDefinition Width="1*"/> </Grid.ColumnDefinitions> <Rectangle x:Name="RectLeftBackground" Width="0" Fill="#FFFFFFFF" IsHitTestVisible="False" /> <Rectangle x:Name="RectLeftShadow" Width="1" Fill="#0D000000" HorizontalAlignment="Left" IsHitTestVisible="False" Grid.Column="1" /> </Grid>

<!-- 主页面容器 --> <Grid x:Name="PanMain" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top"> <Grid.ColumnDefinitions> <ColumnDefinition Width="Auto"/> <ColumnDefinition Width="1*"/> </Grid.ColumnDefinitions> <Border Grid.Column="1" Grid.IsSharedSizeScope="True" UseLayoutRounding="True" SnapsToDevicePixels="True"> <Border x:Name="PanMainRight" RenderOptions.BitmapScalingMode="NearestNeighbor" UseLayoutRounding="False" SnapsToDevicePixels="False" /> </Border> <Border Grid.IsSharedSizeScope="True" UseLayoutRounding="True" SnapsToDevicePixels="True"> <Border x:Name="PanMainLeft" RenderOptions.BitmapScalingMode="NearestNeighbor" UseLayoutRounding="False" SnapsToDevicePixels="False" /> </Border> </Grid>

<!-- 悬浮提示 --> <StackPanel x:Name="PanHint" IsHitTestVisible="False" UseLayoutRounding="True" SnapsToDevicePixels="True" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,20" Grid.RowSpan="2" />

<!-- 浮动多功能按钮区 --> <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Grid.Row="1" Margin="18"> <local:MyExtraButton x:Name="BtnExtraBack" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="返回顶部" Visibility="Collapsed" /> <local:MyExtraButton x:Name="BtnExtraDownload" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="任务管理" Visibility="Collapsed" LogoScale="1.1" /> <local:MyExtraButton x:Name="BtnExtraApril" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="投降" Visibility="Collapsed" /> <local:MyExtraButton x:Name="BtnExtraShutdown" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="关闭 Minecraft" Visibility="Collapsed" /> <local:MyExtraButton x:Name="BtnExtraMusic" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" CanRightClick="True" /> </StackPanel>

<Grid x:Name="PanMsg" Grid.RowSpan="2" Background="#00000000" Visibility="Collapsed" /> </Grid> </Border> </Grid> </Window>
